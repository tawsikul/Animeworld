{
  "name": "Anime World",
  "short_name": "Anime World",
  "description": "Search anime, track episode countdowns, find where to watch, and keep a list.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#060812",
  "theme_color": "#060812",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Browse", "url": "./browse.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Schedule", "url": "./schedule.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "My list", "url": "./account.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
